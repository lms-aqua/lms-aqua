# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Generated by xcodegen from ios/project.yml — never commit it, or it drifts
# from the spec and creates pbxproj merge conflicts.
ios/*.xcodeproj/
ios/Supporting/Info.plist
ios/build/
ios/payload/
ios/*.ipa
*.xcuserstate
xcuserdata/
DerivedData/

# Android
android/.gradle/
android/local.properties
android/app/build/
android/build/
*.apk
*.aab

# Recordings and datasets: these are data, not source, and they get large fast.
lostcam-dataset/
lostcam-recording/
ci-dataset/
*.jsonl
!docs/**/*.jsonl

# TLS material generated for push mode
lostcam-cert.pem
lostcam-key.pem

# OS noise
.DS_Store
Thumbs.db
